{
  "name": "gongarce/lunar-product-properties",
  "description": "Lunar Product Properties Addon",
  "keywords": [
    "lunar",
    "laravel",
    "ecommerce",
    "e-commerce",
    "headless",
    "store",
    "shop",
    "cart"
  ],
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "GonGarce",
      "homepage": "https://github.com/zalito12"
    }
  ],
  "autoload": {
    "psr-4": {
      "Gongarce\\ProductProps\\": "src"
    }
  },
  "extra": {
    "lunar": {
      "name": "Lunar Product Properties"
    },
    "laravel": {
      "providers": [
        "Gongarce\\ProductProps\\ProductPropsServiceProvider"
      ]
    }
  },
  "minimum-stability": "dev",
  "require": {
    "php": "^8.2",
    "lunarphp/lunar": "~1.4.0"
  },
  "prefer-stable": true,
  "require-dev": {
    "orchestra/testbench": "^10.0",
    "pestphp/pest": "^3.0",
    "pestphp/pest-plugin-laravel": "^3.0",
    "pestphp/pest-plugin-livewire": "^3.0"
  },
  "autoload-dev": {
    "psr-4": {
      "Gongarce\\ProductProps\\Tests\\": "tests"
    }
  },
  "scripts": {
    "test": "pest"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
